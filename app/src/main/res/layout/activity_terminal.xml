<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#160A25">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textColor="#D9A7FF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:id="@+id/txtTerminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B0611"
        android:textColor="#CFA6FF"
        android:text="@string/terminal_preview"
        android:textSize="14sp"
        android:padding="12dp"
        android:gravity="top"
        android:fontFamily="monospace" />

    <EditText
        android:id="@+id/edtInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/terminal_hint"
        android:textColor="#FFFFFF"
        android:textColorHint="#A98BBF"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_pesquisar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7B2FBE" />

    <Button
        android:id="@+id/btnParar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_fechar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7B2FBE" />

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_limpar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7B2FBE" />

</LinearLayout>
